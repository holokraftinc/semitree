# Semitree environment variables (copy to .env.local for local dev)

# WordPress headless CMS base URL — PUBLIC, read-only endpoint (not a secret).
# The Semitree frontend reads content from `${NEXT_PUBLIC_WORDPRESS_API_URL}/wp-json/wp/v2`.
#
# Development (current GoDaddy temporary host):
NEXT_PUBLIC_WORDPRESS_API_URL=https://1265580.us28.myftpupload.com
#
# Later, switch to the final CMS domain with ONLY this line — no code changes:
# NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.semitree.in
#
# If unset, the app falls back to the development host above (see
# src/lib/wordpress/config.ts).
