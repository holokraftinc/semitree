# Semitree environment variables (copy to .env.local for local dev)

# WordPress headless CMS base URL — PUBLIC, read-only endpoint (not a secret).
# The Semitree frontend reads content from `${NEXT_PUBLIC_WORDPRESS_API_URL}/wp-json/...`.
#
# PRODUCTION default (used when this var is unset — see src/lib/wordpress/config.ts):
#   https://cms.semitree.in
#
# Set this ONLY for local development, pointing at the temporary GoDaddy host
# until cms.semitree.in is live:
# NEXT_PUBLIC_WORDPRESS_API_URL=https://1265580.us28.myftpupload.com
#
# In production, either leave it unset (defaults to https://cms.semitree.in) or:
# NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.semitree.in
